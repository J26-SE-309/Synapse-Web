{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "requirement_id": {
      "title": "Requirement Id",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "requirement_id",
    "text"
  ],
  "title": "RequirementIn",
  "type": "object"
}

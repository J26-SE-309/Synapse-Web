{
  "$defs": {
    "AmbiguityCandidate": {
      "properties": {
        "candidate": {
          "title": "Candidate",
          "type": "string"
        },
        "similarity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Similarity",
          "type": "number"
        },
        "proximity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Proximity",
          "type": "number"
        },
        "combined_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Combined Score",
          "type": "number"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "candidate_start": {
          "minimum": 0,
          "title": "Candidate Start",
          "type": "integer"
        }
      },
      "required": [
        "candidate",
        "similarity",
        "proximity",
        "combined_score",
        "rank",
        "candidate_start"
      ],
      "title": "AmbiguityCandidate",
      "type": "object"
    },
    "AmbiguityReference": {
      "properties": {
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "reference_kind": {
          "enum": [
            "pronoun",
            "demonstrative",
            "relative"
          ],
          "title": "Reference Kind",
          "type": "string"
        },
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "span": {
          "$ref": "#/$defs/TextSpan"
        },
        "linguistic": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Linguistic",
          "type": "object"
        },
        "candidate_count": {
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "is_ambiguous": {
          "title": "Is Ambiguous",
          "type": "boolean"
        },
        "signals": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Signals",
          "type": "object"
        },
        "candidate_interpretations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AmbiguityCandidate"
          },
          "title": "Candidate Interpretations",
          "type": "array"
        },
        "similarity_gap": {
          "maximum": 1,
          "minimum": 0,
          "title": "Similarity Gap",
          "type": "number"
        },
        "best_candidate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best Candidate"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "competition_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Competition Score",
          "type": "number"
        }
      },
      "required": [
        "reference",
        "reference_kind",
        "position",
        "span",
        "linguistic",
        "candidate_count",
        "is_ambiguous",
        "signals",
        "similarity_gap",
        "confidence",
        "competition_score"
      ],
      "title": "AmbiguityReference",
      "type": "object"
    },
    "AmbiguityResult": {
      "properties": {
        "is_ambiguous": {
          "title": "Is Ambiguous",
          "type": "boolean"
        },
        "score": {
          "description": "1 = highly ambiguous",
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "spans": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TextSpan"
          },
          "title": "Spans",
          "type": "array"
        },
        "references": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AmbiguityReference"
          },
          "title": "References",
          "type": "array"
        },
        "lexical_ambiguities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LexicalAmbiguity"
          },
          "title": "Lexical Ambiguities",
          "type": "array"
        }
      },
      "required": [
        "is_ambiguous",
        "score"
      ],
      "title": "AmbiguityResult",
      "type": "object"
    },
    "LexicalAmbiguity": {
      "properties": {
        "term": {
          "title": "Term",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/TextSpan"
        },
        "candidate_senses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LexicalSenseCandidate"
          },
          "title": "Candidate Senses",
          "type": "array"
        },
        "candidate_count": {
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "top2_margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top2 Margin"
        },
        "normalized_entropy": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Entropy"
        }
      },
      "required": [
        "term",
        "span",
        "candidate_count"
      ],
      "title": "LexicalAmbiguity",
      "type": "object"
    },
    "LexicalSenseCandidate": {
      "properties": {
        "sense": {
          "title": "Sense",
          "type": "string"
        },
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "similarity": {
          "title": "Similarity",
          "type": "number"
        },
        "combined_score": {
          "title": "Combined Score",
          "type": "number"
        }
      },
      "required": [
        "sense",
        "definition",
        "similarity",
        "combined_score"
      ],
      "title": "LexicalSenseCandidate",
      "type": "object"
    },
    "QualityIssue": {
      "properties": {
        "type": {
          "description": "Defect category, e.g. incomplete, inconsistent, grammar, missing_information",
          "title": "Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "terms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "title": "QualityIssue",
      "type": "object"
    },
    "QualityResult": {
      "properties": {
        "label": {
          "description": "Overall quality category",
          "title": "Label",
          "type": "string"
        },
        "score": {
          "description": "1 = high quality",
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QualityIssue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "label",
        "score"
      ],
      "title": "QualityResult",
      "type": "object"
    },
    "StabilityResult": {
      "properties": {
        "label": {
          "enum": [
            "stable",
            "potentially_unstable"
          ],
          "title": "Label",
          "type": "string"
        },
        "score": {
          "description": "1 = interpretation fully stable under rewording",
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "label",
        "score"
      ],
      "title": "StabilityResult",
      "type": "object"
    },
    "TextSpan": {
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ],
      "title": "TextSpan",
      "type": "object"
    },
    "VaguenessResult": {
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "terms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TextSpan"
          },
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "count"
      ],
      "title": "VaguenessResult",
      "type": "object"
    }
  },
  "properties": {
    "requirement_id": {
      "title": "Requirement Id",
      "type": "string"
    },
    "quality": {
      "$ref": "#/$defs/QualityResult"
    },
    "ambiguity": {
      "$ref": "#/$defs/AmbiguityResult"
    },
    "vagueness": {
      "$ref": "#/$defs/VaguenessResult"
    },
    "stability": {
      "$ref": "#/$defs/StabilityResult"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    },
    "model_version": {
      "title": "Model Version",
      "type": "string"
    },
    "analysed_at": {
      "format": "date-time",
      "title": "Analysed At",
      "type": "string"
    }
  },
  "required": [
    "requirement_id",
    "quality",
    "ambiguity",
    "vagueness",
    "stability",
    "confidence",
    "explanation",
    "model_version",
    "analysed_at"
  ],
  "title": "RequirementAnalysis",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

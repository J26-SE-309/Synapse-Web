{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ModelConfiguration": {
      "properties": {
        "encoder": {
          "title": "Encoder",
          "type": "string"
        },
        "learner": {
          "title": "Learner",
          "type": "string"
        },
        "formulation": {
          "enum": [
            "single_task",
            "multi_task",
            "chained"
          ],
          "title": "Formulation",
          "type": "string"
        }
      },
      "required": [
        "encoder",
        "learner",
        "formulation"
      ],
      "title": "ModelConfiguration",
      "type": "object"
    },
    "Prediction": {
      "properties": {
        "story_id": {
          "title": "Story Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "predicted_story_points": {
          "minimum": 0,
          "title": "Predicted Story Points",
          "type": "number"
        },
        "effort_category": {
          "enum": [
            "small",
            "medium",
            "large",
            "extra_large"
          ],
          "title": "Effort Category",
          "type": "string"
        },
        "prediction_interval": {
          "$ref": "#/$defs/PredictionInterval"
        },
        "sprint_risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Sprint Risk Level",
          "type": "string"
        },
        "spillover_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Spillover Probability",
          "type": "number"
        },
        "confidence_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence Score",
          "type": "number"
        },
        "key_risk_reasons": {
          "items": {
            "$ref": "#/$defs/RiskReason"
          },
          "title": "Key Risk Reasons",
          "type": "array"
        },
        "recommendations": {
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "title": "Recommendations",
          "type": "array"
        },
        "model_configuration": {
          "$ref": "#/$defs/ModelConfiguration"
        },
        "selection_mode": {
          "enum": [
            "auto",
            "pinned"
          ],
          "title": "Selection Mode",
          "type": "string"
        },
        "feature_groups_used": {
          "items": {
            "type": "string"
          },
          "title": "Feature Groups Used",
          "type": "array"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "prediction_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Audit record id (FR21); for feedback (FR19)",
          "title": "Prediction Id"
        },
        "interval_coverage": {
          "default": 0.8,
          "description": "Share of stories whose points fall in the interval",
          "title": "Interval Coverage",
          "type": "number"
        },
        "at_risk": {
          "default": false,
          "description": "The risk passes the threshold chosen for recall >= 0.70",
          "title": "At Risk",
          "type": "boolean"
        },
        "confidence_level": {
          "default": "low",
          "description": "Band shown to users",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence Level",
          "type": "string"
        },
        "configuration_id": {
          "default": "",
          "title": "Configuration Id",
          "type": "string"
        },
        "selection_reason": {
          "default": "",
          "title": "Selection Reason",
          "type": "string"
        },
        "degraded_feature_groups": {
          "default": [],
          "description": "Groups served by a proxy or missing (FR17)",
          "items": {
            "type": "string"
          },
          "title": "Degraded Feature Groups",
          "type": "array"
        },
        "feature_sources": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "component, request, history, text, proxy or missing",
          "title": "Feature Sources",
          "type": "object"
        },
        "explanation_method": {
          "default": "",
          "title": "Explanation Method",
          "type": "string"
        }
      },
      "required": [
        "story_id",
        "project_id",
        "predicted_story_points",
        "effort_category",
        "prediction_interval",
        "sprint_risk_level",
        "spillover_probability",
        "confidence_score",
        "key_risk_reasons",
        "recommendations",
        "model_configuration",
        "selection_mode",
        "feature_groups_used",
        "model_version",
        "generated_at"
      ],
      "title": "Prediction",
      "type": "object"
    },
    "PredictionInterval": {
      "properties": {
        "lower": {
          "minimum": 0,
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "minimum": 0,
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "PredictionInterval",
      "type": "object"
    },
    "Recommendation": {
      "properties": {
        "action": {
          "enum": [
            "split_story",
            "refine_requirement",
            "add_acceptance_criteria",
            "create_tests",
            "resolve_dependency",
            "reduce_sprint_scope"
          ],
          "title": "Action",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "triggered_by": {
          "title": "Triggered By",
          "type": "string"
        }
      },
      "required": [
        "action",
        "message",
        "triggered_by"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "RecordedFeedback": {
      "properties": {
        "prediction_id": {
          "title": "Prediction Id",
          "type": "string"
        },
        "decision": {
          "enum": [
            "accept",
            "adjust",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "target": {
          "default": "estimate",
          "enum": [
            "estimate",
            "risk",
            "recommendation"
          ],
          "title": "Target",
          "type": "string"
        },
        "recommendation_action": {
          "anyOf": [
            {
              "enum": [
                "split_story",
                "refine_requirement",
                "add_acceptance_criteria",
                "create_tests",
                "resolve_dependency",
                "reduce_sprint_scope"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommendation Action"
        },
        "adjusted_story_points": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjusted Story Points"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "prediction_id",
        "decision",
        "id",
        "created_at"
      ],
      "title": "RecordedFeedback",
      "type": "object"
    },
    "RecordedOutcome": {
      "properties": {
        "prediction_id": {
          "title": "Prediction Id",
          "type": "string"
        },
        "completed_in_sprint": {
          "title": "Completed In Sprint",
          "type": "boolean"
        },
        "actual_story_points": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Story Points"
        },
        "reopened": {
          "default": false,
          "title": "Reopened",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "prediction_id",
        "completed_in_sprint",
        "id",
        "created_at"
      ],
      "title": "RecordedOutcome",
      "type": "object"
    },
    "RiskReason": {
      "properties": {
        "factor": {
          "description": "Planning factor shown to users, e.g. 'Requirement ambiguity'",
          "title": "Factor",
          "type": "string"
        },
        "direction": {
          "enum": [
            "increases",
            "decreases"
          ],
          "title": "Direction",
          "type": "string"
        },
        "weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "factor",
        "direction",
        "weight"
      ],
      "title": "RiskReason",
      "type": "object"
    }
  },
  "description": "One prediction as it was sent, what the models saw (FR21), and what was decided and happened (FR19).",
  "properties": {
    "prediction_id": {
      "title": "Prediction Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "sprint_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sprint Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "prediction": {
      "$ref": "#/$defs/Prediction"
    },
    "features": {
      "additionalProperties": true,
      "description": "The feature values the models saw",
      "title": "Features",
      "type": "object"
    },
    "feedback": {
      "items": {
        "$ref": "#/$defs/RecordedFeedback"
      },
      "title": "Feedback",
      "type": "array"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/RecordedOutcome"
      },
      "title": "Outcomes",
      "type": "array"
    }
  },
  "required": [
    "prediction_id",
    "project_id",
    "created_at",
    "prediction",
    "features",
    "feedback",
    "outcomes"
  ],
  "title": "PredictionDetail",
  "type": "object"
}

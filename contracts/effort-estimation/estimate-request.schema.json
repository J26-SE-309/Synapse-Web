{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "StoryInput": {
      "properties": {
        "story_id": {
          "title": "Story Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "acceptance_criteria": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "issue_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue Type"
        },
        "priority": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority"
        },
        "story_points": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The team's estimate, if the story has one",
          "title": "Story Points"
        },
        "blocker_count": {
          "default": 0,
          "minimum": 0,
          "title": "Blocker Count",
          "type": "integer"
        },
        "dep_in_degree": {
          "default": 0,
          "minimum": 0,
          "title": "Dep In Degree",
          "type": "integer"
        },
        "dep_out_degree": {
          "default": 0,
          "minimum": 0,
          "title": "Dep Out Degree",
          "type": "integer"
        },
        "upstream": {
          "$ref": "#/$defs/UpstreamSignals",
          "default": {
            "ambiguity_score": null,
            "vague_term_count": null,
            "missing_info_flag_count": null,
            "ac_completeness_score": null,
            "invest_compliance_flags": null,
            "traceability_coverage_pct": null,
            "unlinked_artifact_count": null,
            "has_linked_tests": null
          }
        }
      },
      "required": [
        "story_id",
        "title"
      ],
      "title": "StoryInput",
      "type": "object"
    },
    "UpstreamSignals": {
      "description": "Features supplied by Components 1-3 through the gateway. Any of them may be missing (FR17).",
      "properties": {
        "ambiguity_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ambiguity Score"
        },
        "vague_term_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vague Term Count"
        },
        "missing_info_flag_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Info Flag Count"
        },
        "ac_completeness_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ac Completeness Score"
        },
        "invest_compliance_flags": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "boolean"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invest Compliance Flags"
        },
        "traceability_coverage_pct": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceability Coverage Pct"
        },
        "unlinked_artifact_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unlinked Artifact Count"
        },
        "has_linked_tests": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Linked Tests"
        }
      },
      "title": "UpstreamSignals",
      "type": "object"
    }
  },
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "sprint_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sprint Id"
    },
    "stories": {
      "items": {
        "$ref": "#/$defs/StoryInput"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Stories",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "stories"
  ],
  "title": "EstimateRequest",
  "type": "object"
}

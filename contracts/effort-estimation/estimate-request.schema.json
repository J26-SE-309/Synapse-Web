{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SprintContext": {
      "properties": {
        "length_days": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Days"
        },
        "parallel_sprints": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Other sprints of the project running",
          "title": "Parallel Sprints"
        },
        "wip": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Issues of the sprint already in progress",
          "title": "Wip"
        },
        "capacity_points": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Planned capacity (default: velocity)",
          "title": "Capacity Points"
        }
      },
      "title": "SprintContext",
      "type": "object"
    },
    "StoryInput": {
      "properties": {
        "story_id": {
          "title": "Story Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "acceptance_criteria": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "issue_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Story, Task, Bug, Improvement or New Feature",
          "title": "Issue Type"
        },
        "priority": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Jira priority name, e.g. Major or High",
          "title": "Priority"
        },
        "story_points": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The team's estimate, if the story has one",
          "title": "Story Points"
        },
        "blocker_count": {
          "default": 0,
          "description": "Open issues this story is blocked by",
          "minimum": 0,
          "title": "Blocker Count",
          "type": "integer"
        },
        "dep_in_degree": {
          "default": 0,
          "description": "Issues that depend on this story",
          "minimum": 0,
          "title": "Dep In Degree",
          "type": "integer"
        },
        "dep_out_degree": {
          "default": 0,
          "description": "Issues this story depends on",
          "minimum": 0,
          "title": "Dep Out Degree",
          "type": "integer"
        },
        "linked_issue_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "All linked issues, any link type",
          "title": "Linked Issue Count"
        },
        "has_epic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The story belongs to an epic (unknown if left out)",
          "title": "Has Epic"
        },
        "in_progress": {
          "default": false,
          "description": "Work on the story has already started",
          "title": "In Progress",
          "type": "boolean"
        },
        "added_mid_sprint": {
          "default": false,
          "description": "Added after the sprint started",
          "title": "Added Mid Sprint",
          "type": "boolean"
        },
        "days_into_sprint": {
          "default": 0,
          "description": "Days after the sprint start it was added",
          "minimum": 0,
          "title": "Days Into Sprint",
          "type": "number"
        },
        "upstream": {
          "$ref": "#/$defs/UpstreamSignals",
          "default": {
            "ambiguity_score": null,
            "vague_term_count": null,
            "missing_info_flag_count": null,
            "ac_completeness_score": null,
            "invest_compliance_flags": null,
            "traceability_coverage_pct": null,
            "unlinked_artifact_count": null,
            "has_linked_tests": null
          }
        }
      },
      "required": [
        "story_id",
        "title"
      ],
      "title": "StoryInput",
      "type": "object"
    },
    "TeamContext": {
      "description": "The team's recent delivery, as the platform knows it. Unknown history means a cold start: the pooled\nconfiguration answers and the confidence is lowered.",
      "properties": {
        "velocity_mean": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean points finished, last 3 sprints",
          "title": "Velocity Mean"
        },
        "velocity_variance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Variance of points, last 5 sprints",
          "title": "Velocity Variance"
        },
        "closed_sprints": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How many sprints the team has closed",
          "title": "Closed Sprints"
        },
        "mean_cycle_time_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Cycle Time Hours"
        },
        "spillover_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Share of recent stories spilled",
          "title": "Spillover Rate"
        },
        "reopen_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reopen Rate"
        }
      },
      "title": "TeamContext",
      "type": "object"
    },
    "UpstreamSignals": {
      "description": "Features supplied by Components 1-3 through the gateway. Any of them may be missing (FR17): the service\nthen uses its own proxies computed from the story text and flags the group as degraded.",
      "properties": {
        "ambiguity_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ambiguity Score"
        },
        "vague_term_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vague Term Count"
        },
        "missing_info_flag_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Info Flag Count"
        },
        "ac_completeness_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ac Completeness Score"
        },
        "invest_compliance_flags": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "boolean"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invest Compliance Flags"
        },
        "traceability_coverage_pct": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceability Coverage Pct"
        },
        "unlinked_artifact_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unlinked Artifact Count"
        },
        "has_linked_tests": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Linked Tests"
        }
      },
      "title": "UpstreamSignals",
      "type": "object"
    }
  },
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "sprint_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sprint Id"
    },
    "stories": {
      "items": {
        "$ref": "#/$defs/StoryInput"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Stories",
      "type": "array"
    },
    "team_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/TeamContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sprint_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/SprintContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pinned_configuration": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Answer with this configuration (FR12)",
      "title": "Pinned Configuration"
    }
  },
  "required": [
    "project_id",
    "stories"
  ],
  "title": "EstimateRequest",
  "type": "object"
}

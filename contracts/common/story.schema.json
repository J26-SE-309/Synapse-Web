{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "UpstreamSignals": {
      "description": "What Components 1-3 found about a story, as the effort service reads it (its estimate request's upstream).",
      "properties": {
        "ambiguity_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ambiguity Score"
        },
        "vague_term_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vague Term Count"
        },
        "missing_info_flag_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Info Flag Count"
        },
        "ac_completeness_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ac Completeness Score"
        },
        "invest_compliance_flags": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "boolean"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invest Compliance Flags"
        },
        "traceability_coverage_pct": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceability Coverage Pct"
        },
        "unlinked_artifact_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unlinked Artifact Count"
        },
        "has_linked_tests": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Linked Tests"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Who produced them when not the components, e.g. synthetic",
          "title": "Source"
        }
      },
      "title": "UpstreamSignals",
      "type": "object"
    }
  },
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "story_id": {
      "title": "Story Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "acceptance_criteria": {
      "items": {
        "type": "string"
      },
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "issue_type": {
      "anyOf": [
        {
          "enum": [
            "Story",
            "Task",
            "Bug",
            "Improvement",
            "New Feature"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Issue Type"
    },
    "priority": {
      "anyOf": [
        {
          "enum": [
            "Blocker",
            "Critical",
            "Major",
            "Minor",
            "Trivial"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Priority"
    },
    "story_points": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Story Points"
    },
    "epic": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Epic"
    },
    "blocked_by": {
      "title": "Blocked By",
      "type": "integer"
    },
    "depends_on": {
      "title": "Depends On",
      "type": "integer"
    },
    "needed_by": {
      "title": "Needed By",
      "type": "integer"
    },
    "status": {
      "enum": [
        "to_do",
        "in_progress",
        "done"
      ],
      "title": "Status",
      "type": "string"
    },
    "rank": {
      "description": "Its place in the backlog and in its sprint: lower comes first",
      "title": "Rank",
      "type": "number"
    },
    "sprint_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The sprint it is in now; empty in the backlog",
      "title": "Sprint Id"
    },
    "source": {
      "enum": [
        "manual",
        "import",
        "refinement"
      ],
      "title": "Source",
      "type": "string"
    },
    "synthetic": {
      "description": "Made-up data for development and demonstrations, never evidence",
      "title": "Synthetic",
      "type": "boolean"
    },
    "upstream": {
      "anyOf": [
        {
          "$ref": "#/$defs/UpstreamSignals"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What Components 1-3 found about the story; cleared when its title, description or criteria change"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Started At"
    },
    "resolved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Resolved At"
    },
    "reopened": {
      "title": "Reopened",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "story_id",
    "title",
    "description",
    "acceptance_criteria",
    "issue_type",
    "priority",
    "story_points",
    "epic",
    "blocked_by",
    "depends_on",
    "needed_by",
    "status",
    "rank",
    "sprint_id",
    "source",
    "synthetic",
    "started_at",
    "resolved_at",
    "reopened",
    "created_at",
    "updated_at"
  ],
  "title": "Story",
  "type": "object"
}

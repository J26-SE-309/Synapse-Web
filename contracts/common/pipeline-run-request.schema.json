{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RequirementText": {
      "properties": {
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "text"
      ],
      "title": "RequirementText",
      "type": "object"
    }
  },
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "sprint_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sprint Id"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/RequirementText"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "requirements"
  ],
  "title": "PipelineRequest",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "key": {
      "description": "Prefix of its story and sprint ids (MFP-12, MFP-S5)",
      "title": "Key",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "data_source": {
      "description": "platform: created in Synapse; tawos: a TAWOS project's sprints replayed",
      "enum": [
        "platform",
        "tawos",
        "synthetic"
      ],
      "title": "Data Source",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "key",
    "description",
    "data_source",
    "created_at"
  ],
  "title": "Project",
  "type": "object"
}

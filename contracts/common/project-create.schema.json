{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "description": "Short key the components store data under, e.g. TUTOR; it cannot change later",
      "maxLength": 32,
      "minLength": 2,
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "key": {
      "anyOf": [
        {
          "maxLength": 5,
          "minLength": 2,
          "pattern": "^[A-Z][A-Z0-9]{1,4}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Prefix of its story and sprint ids, e.g. MFP for MFP-12; empty: the name's initials. It cannot change later",
      "title": "Key"
    },
    "description": {
      "default": "",
      "maxLength": 500,
      "title": "Description",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "ProjectCreate",
  "type": "object"
}

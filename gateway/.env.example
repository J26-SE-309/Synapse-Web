# Copy to gateway/.env to override the defaults in app/config.py. Never commit .env.
DATABASE_URL=postgresql+psycopg://platform_user:platform-local@localhost:5440/platform_db
CORS_ORIGINS=["http://localhost:3000"]

# Where each component's API runs.
REQUIREMENT_QUALITY_URL=http://localhost:8001
STORY_REFINEMENT_URL=http://localhost:8002
TRACEABILITY_URL=http://localhost:8003
EFFORT_ESTIMATION_URL=http://localhost:8004

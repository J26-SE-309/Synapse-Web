# Copy to gateway/.env to override the defaults in app/config.py. Never commit .env.

# The hosted database (Neon): its direct connection string (host without -pooler), as Neon shows it. Leave it out
# to use the local one, the platform-db container (LOCAL_DATABASE_URL; docker compose sets it for the container).
# docker compose passes this file to the gateway container too.
# DATABASE_URL=postgresql://platform_user:<password>@<endpoint>.<region>.aws.neon.tech/platform_db?sslmode=require
LOCAL_DATABASE_URL=postgresql+psycopg://platform_user:platform-local@localhost:5440/platform_db
CORS_ORIGINS=["http://localhost:3000"]

# Where each component's API runs (when the gateway runs outside Docker).
REQUIREMENT_QUALITY_URL=http://localhost:8001
STORY_REFINEMENT_URL=http://localhost:8002
TRACEABILITY_URL=http://localhost:8003
EFFORT_ESTIMATION_URL=http://localhost:8004
